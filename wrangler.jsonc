{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "simple-invoicing",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-24",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "simple-invoicing-db",
			"database_id": "9a064dc9-5074-4cd7-95b3-110f183aaaf5",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "simple-invoicing-uploads"
		}
	]
}
