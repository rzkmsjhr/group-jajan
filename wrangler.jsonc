{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "simple-invoicing",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-24",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "simple-invoicing-db",
			"database_id": "9a064dc9-5074-4cd7-95b3-110f183aaaf5",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "simple-invoicing-uploads"
		}
	],
	"ratelimits": [
		{
			"name": "MENU_CREATE_LIMITER",
			"namespace_id": "727401",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "MENU_UPDATE_LIMITER",
			"namespace_id": "727402",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "ORDER_CREATE_LIMITER",
			"namespace_id": "727403",
			"simple": { "limit": 2, "period": 60 }
		},
		{
			"name": "ORDER_CANCEL_LIMITER",
			"namespace_id": "727404",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "PROOF_UPLOAD_LIMITER",
			"namespace_id": "727405",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "STATUS_UPDATE_LIMITER",
			"namespace_id": "727406",
			"simple": { "limit": 30, "period": 60 }
		},
		{
			"name": "VISIBILITY_UPDATE_LIMITER",
			"namespace_id": "727407",
			"simple": { "limit": 20, "period": 60 }
		}
	]
}
